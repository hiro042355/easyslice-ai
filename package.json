    "test:postgresql-environment": "tsx --test --test-concurrency=1 tests/postgresqlTestEnvironment/postgresqlFoundationSuite.test.ts",
    "test:postgresql-reconciliation-migration": "tsx --test --test-concurrency=1 tests/postgresqlTestEnvironment/reconciliationMigration.test.ts",
    "test:slice-a-postgresql-stores": "tsx --test --test-concurrency=1 tests/sliceAPostgresqlStores/*.test.ts",
    "test:postgresql-transaction": "tsx --test --test-concurrency=1 tests/durableTransactionV2/*.test.ts",
    "test:reconciliation-runtime": "tsx --test --test-concurrency=1 tests/reconciliationRuntime/*.test.ts",

    "ffmpeg-static": "5.3.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.5.0",
    "html-to-image": "^1.11.13",
    "next": "16.2.7",
    "pg": "8.22.0",
    "posthog-js": "^1.398.0",
    "rc-slider": "^11.1.9",
